# Copy to .env.local. Never commit real values.

# Where the local database lives (PGlite, Postgres-compatible). Default: .data/pglite
# RXG_DATA_DIR=.data/pglite

# Who the app records as the actor in the audit log until real sign-in exists.
# Must match a user email in the database. Default: the first admin.
# RXG_ACTING_USER=admin@example.com

# Google Sheets read (optional). A Google Cloud service account with the
# spreadsheets.readonly scope. Paste the whole key JSON on one line, or point
# GOOGLE_APPLICATION_CREDENTIALS at the key file. Share each sheet with the
# service account's email as Viewer. The app never writes to a sheet.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

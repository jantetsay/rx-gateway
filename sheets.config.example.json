{
  "_note": "Example mapping for a tracking sheet. Paste the tabs object into Settings > Sheets when you add a source. Tab and column names only, never data. Keep real mappings out of git.",
  "tabs": [
    {
      "kind": "tasks",
      "tab": "Delivery tasks",
      "headerRow": 1,
      "defaults": { "workstream": "env_config", "stage": "validate_go_live", "gate": "G6", "critical": false },
      "columns": { "key": "ID", "title": "Task", "status": "Status", "due": "Due", "completed": "Completed", "lastTouched": "Last updated", "owner": "Owner" },
      "statusMap": { "Open": "not_started", "Working": "in_progress", "Stuck": "blocked", "Closed": "done" }
    },
    {
      "kind": "edi_partners",
      "tab": "EDI partners",
      "headerRow": 1,
      "defaultStage": 1,
      "columns": { "name": "Partner", "nextStep": "Next step", "nextStepDate": "Due", "status": "Status", "lastContact": "Last contact" },
      "doneStates": ["done", "complete", "closed"]
    }
  ]
}
